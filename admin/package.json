{
  "name": "prizma-admin",
  "version": "1.0.0",
  "description": "PRIZMA tattoo studio - admin console (Electron + React)",
  "author": "PRIZMA studio",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev": "node dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "prizma.admin",
    "productName": "PRIZMA Admin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "PRIZMA-Admin.exe"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {}
}
